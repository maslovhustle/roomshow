# Supabase Realtime is the message bus between the phone and the stage.
#
# Both values are publishable by design — Supabase ships them to every browser
# that loads any app built on it, and they grant nothing on their own. Committing
# them is what makes the app work out of the box with no setup screen; a user can
# still point it at their own project from the home page, which overrides these.
VITE_SUPABASE_URL=https://ecxwacjcrgaabqxhitpp.supabase.co
VITE_SUPABASE_KEY=sb_publishable_9mR1-DtJQWvQzvw71ZBoUw_BkBHf3o7

# The AI engine, baked in so the app works without a setup step.
#
# Unlike the Supabase keys above this one is NOT publishable by design: anyone
# who reads the bundle can spend GPU time on it. It is acceptable only because
# the pod is temporary and the token is trivially rotated — change the token on
# the box and redeploy and every old link is dead.
#
# A rented pod gets a new id every time it is created, so this needs updating
# and redeploying whenever the box is replaced.
VITE_DIFFUSION_URL=wss://59w5rc7f4zzymp-8888.proxy.runpod.net/?token=rs_b6a7b5f9eeacafc0a37b7aee

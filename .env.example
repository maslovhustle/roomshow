# Copy to .env.local and fill in. Never commit the result.

# The AI engine: an origin running Daydream Scope, e.g. a RunPod pod.
#   https://…  Scope over WebRTC   (src/stylizer/scope.ts)
#   wss://…    the older per-frame socket engine (src/stylizer/diffusion.ts)
VITE_DIFFUSION_URL=https://your-scope-box:8000

# ICE servers as the JSON array RTCPeerConnection expects.
#
# A relay is not optional for the cloud path: a rented pod sits behind a proxy
# that forwards HTTP but not the inbound UDP video needs, so without one the
# browser and the pod never meet. Scope has its own relay lookup, but it points
# at turn.fastrtc.org, a domain that no longer resolves anywhere.
#
# Mint a set from a Cloudflare Realtime TURN key (free tier, 1TB/month):
#   curl -H "Authorization: Bearer $CF_API_TOKEN" -H "Content-Type: application/json" \
#     -d '{"ttl": 86400}' \
#     https://rtc.live.cloudflare.com/v1/turn/keys/$CF_KEY_ID/credentials/generate-ice-servers
VITE_TURN_SERVERS=[{"urls":["turn:…"],"username":"…","credential":"…"}]
